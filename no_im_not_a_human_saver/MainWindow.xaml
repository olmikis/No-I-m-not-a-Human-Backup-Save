<Window x:Class="no_im_not_a_human_saver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:no_im_not_a_human_saver"
        mc:Ignorable="d"
        Title="No, I'm not a Human Backup Save" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">Путь до Steam: </TextBlock>
            <TextBox x:Name="SteamPathBox" Width="400" Height="20" IsReadOnly="True" VerticalAlignment="Center"/>
            <Button x:Name="BrowseSteamButton" Content="..." Padding="0" Margin="10,0" Height="20" Click="BrowseSteamButton_Click" Width="25"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock VerticalAlignment="Center" Margin="0,0,10,0">Комментарий (не обязательно): </TextBlock>
            <TextBox x:Name="CommentBox" Width="200" Height="25" VerticalAlignment="Center" MaxLength="50"/>
            <Button x:Name="BackupButton" Content="Сделать бэкап" Padding="2" Margin="10,0" Click="BackupButton_Click" Width="107"/>
        </StackPanel>
        <ListView x:Name="SavesList" Grid.Row="2" Margin="0,0,0,10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Файл" DisplayMemberBinding="{Binding Name}" Width="250"/>
                    <GridViewColumn Header="Дата копирования" DisplayMemberBinding="{Binding Date}" Width="150"/>
                    <GridViewColumn Header="Комментарий" DisplayMemberBinding="{Binding Comment}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>
        <Button x:Name="RestoreButton" Content="Восстановить выбранный" Grid.Row="3" Padding="10" Click="RestoreButton_Click"/>
    </Grid>
</Window>
